---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProductGrid from "../components/produk/ProductGrid.astro";

const products = await getCollection("products");
const newArrivals = products.filter((p) => p.data.badge === "baru").map((p) => p.data);
---

<Layout
  title="New Arrival - Blume & Co."
  description="Produk terbaru lintas kategori flower, cake, dan gift. Order via WhatsApp."
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-10 md:pt-16">
    <h1 class="font-display text-3xl font-semibold text-ink md:text-5xl">New Arrival</h1>
    <p class="mt-3 max-w-lg text-muted">Produk terbaru lintas kategori, baru masuk katalog kami.</p>
  </section>
  <section class="mx-auto max-w-6xl px-4 py-8">
    <ProductGrid products={newArrivals} />
  </section>
</Layout>
