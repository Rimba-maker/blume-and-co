---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProductGrid from "../../components/produk/ProductGridReveal.astro";
import { cakeGiftGroups } from "../../lib/navData";

const products = await getCollection("products");
const items = products.filter((p) => p.data.category === "cake-gift").map((p) => p.data);
---

<Layout
  title="Cake & Gift - Blume & Co."
  description="Cake, hampers, dan gift personalized berkualitas, order gampang via WhatsApp. Kirim ke 35 kota se-Indonesia."
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-10 md:pt-16">
    <h1 class="font-display text-3xl font-semibold text-ink md:text-5xl">Cake & Gift</h1>
    <p class="mt-3 max-w-lg text-muted">
      Cake custom, hampers, sampai kado personalized untuk tiap momen.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8">
    <div class="grid gap-4 md:grid-cols-5">
      {cakeGiftGroups.map((group) => (
        <div class={`rounded-md p-4 ${group.tint}`}>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted">{group.title}</p>
          <ul class="flex flex-col gap-1.5">
            {group.items.map((s) => (
              <li>
                <a href={`/cake-gift/${s.slug}/`} class="text-sm text-ink hover:underline">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <ProductGrid products={items} />
  </section>
</Layout>
