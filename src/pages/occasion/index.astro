---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { occasionImage } from "../../lib/occasionImages";

const occasions = await getCollection("occasions");
---

<Layout
  title="Occasion - Blume & Co."
  description="Kado dan flower yang dikurasi per occasion, dari wedding sampai corporate event. Order via WhatsApp."
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-10 md:pt-16">
    <h1 class="font-display text-3xl font-semibold text-ink md:text-5xl">Occasion</h1>
    <p class="mt-3 max-w-lg text-muted">Pilih momen, kami kurasikan produk yang pas.</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
      {occasions.map((occasion) => (
        <a
          href={`/occasion/${occasion.data.slug}/`}
          class="group relative block h-48 overflow-hidden rounded-md"
        >
          <img
            src={occasionImage(occasion.data.slug, 600)}
            alt={occasion.data.name}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/70 to-transparent" />
          <p class="absolute bottom-4 left-4 font-display text-lg font-semibold text-bg">
            {occasion.data.name}
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>
