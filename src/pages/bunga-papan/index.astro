---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProductGrid from "../../components/produk/ProductGrid.astro";
import { bungaPapanSubcategories } from "../../lib/navData";

const products = await getCollection("products");
const items = products.filter((p) => p.data.category === "bunga-papan").map((p) => p.data);
---

<Layout
  title="Bunga Papan - Blume & Co."
  description="Bunga papan dan standing flower berkualitas, order gampang via WhatsApp. Kirim ke 35 kota se-Indonesia."
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-16">
    <h1 class="font-display text-3xl font-semibold text-ink md:text-5xl">Bunga Papan</h1>
    <p class="mt-3 max-w-lg text-muted">
      Papan bunga, standing flower, sampai standing giant flower untuk acara besar dan korporat.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8">
    <div class="flex flex-wrap gap-2">
      {bungaPapanSubcategories.map((s) => (
        <a
          href={`/bunga-papan/${s.slug}/`}
          class="rounded-full border border-hairline px-4 py-2 text-sm text-ink hover:bg-surface-card"
        >
          {s.label}
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <ProductGrid products={items} />
  </section>
</Layout>
