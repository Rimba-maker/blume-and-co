---
import Layout from "../../layouts/Layout.astro";
import { locationRegions } from "../../lib/navData";
---

<Layout
  title="Lokasi Pengiriman - Blume & Co."
  description="Blume & Co. kirim flower, cake, dan gift ke 35 kota se-Indonesia. Cek kota kamu di sini."
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-10 md:pt-16">
    <h1 class="font-display text-3xl font-semibold text-ink md:text-5xl">Lokasi Pengiriman</h1>
    <p class="mt-3 max-w-lg text-muted">Kami kirim ke 35 kota se-Indonesia, dari Jakarta sampai Jayapura.</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="grid gap-8 md:grid-cols-2">
      {locationRegions.map((group) => (
        <div>
          <h2 class="font-display text-lg font-semibold text-ink">{group.region}</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {group.cities.map((city) => (
              <a
                href={`/lokasi/${city.slug}/`}
                class="rounded-full border border-hairline px-4 py-2 text-sm text-ink hover:bg-surface-card"
              >
                {city.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
