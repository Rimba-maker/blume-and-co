---
// Notion pastel-tinted feature card pattern for the 3 top-level category doors.
const categories = [
  {
    name: "Flower",
    blurb: "Buket segar, forever flower, sampai bunga meja.",
    href: "/flower/",
    image: "https://images.pexels.com/photos/5362014/pexels-photo-5362014.jpeg?auto=compress&cs=tinysrgb&w=900",
    tint: "from-pastel-pink/60",
  },
  {
    name: "Cake & Gift",
    blurb: "Cake custom, hampers, sampai kado personalized.",
    href: "/cake-gift/",
    image: "https://images.pexels.com/photos/8015149/pexels-photo-8015149.jpeg?auto=compress&cs=tinysrgb&w=900",
    tint: "from-primary/50",
  },
  {
    name: "Bunga Papan",
    blurb: "Papan bunga dan standing flower untuk acara besar.",
    href: "/bunga-papan/",
    image: "https://images.pexels.com/photos/32176843/pexels-photo-32176843.jpeg?auto=compress&cs=tinysrgb&w=900",
    tint: "from-pastel-purple/55",
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
  <h2 class="mb-6 font-display text-2xl font-semibold text-ink md:text-3xl">Kategori Utama</h2>
  <div class="grid grid-cols-2 gap-3 md:gap-4 md:grid-rows-2">
    {categories.map((cat, i) => (
      <a
        href={cat.href}
        class:list={[
          "group relative block overflow-hidden rounded-lg",
          i === 0
            ? "col-span-2 h-48 md:col-span-1 md:row-span-2 md:h-full"
            : "h-40 md:h-full",
        ]}
      >
        <img
          src={cat.image}
          alt={cat.name}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <div class:list={["absolute inset-0 bg-gradient-to-t", cat.tint, "to-transparent"]} />
        <div class="absolute bottom-0 p-4 md:p-6">
          <h3 class="font-display text-base font-semibold text-ink md:text-xl">{cat.name}</h3>
          <p class="mt-1 max-w-[22ch] text-xs text-ink/80 md:text-sm">{cat.blurb}</p>
        </div>
      </a>
    ))}
  </div>
</section>
