---
// Notion pastel-tinted feature card pattern for the 3 top-level category doors.
const categories = [
  {
    name: "Flower",
    blurb: "Buket segar, forever flower, sampai bunga meja.",
    href: "/flower/",
    image: "https://picsum.photos/seed/blume-kategori-flower/800/900",
    tint: "from-pastel-pink/60",
  },
  {
    name: "Cake & Gift",
    blurb: "Cake custom, hampers, sampai kado personalized.",
    href: "/cake-gift/",
    image: "https://picsum.photos/seed/blume-kategori-cake-gift/800/900",
    tint: "from-primary/50",
  },
  {
    name: "Bunga Papan",
    blurb: "Papan bunga dan standing flower untuk acara besar.",
    href: "/bunga-papan/",
    image: "https://picsum.photos/seed/blume-kategori-bunga-papan/800/900",
    tint: "from-pastel-purple/55",
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="mb-6 font-display text-2xl font-semibold text-ink md:text-3xl">Kategori Utama</h2>
  <div class="grid gap-4 md:grid-cols-3">
    {categories.map((cat) => (
      <a href={cat.href} class="group relative block h-80 overflow-hidden rounded-lg">
        <img
          src={cat.image}
          alt={cat.name}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <div class:list={["absolute inset-0 bg-gradient-to-t", cat.tint, "to-transparent"]} />
        <div class="absolute bottom-0 p-6">
          <h3 class="font-display text-xl font-semibold text-ink">{cat.name}</h3>
          <p class="mt-1 max-w-[22ch] text-sm text-ink/80">{cat.blurb}</p>
        </div>
      </a>
    ))}
  </div>
</section>
