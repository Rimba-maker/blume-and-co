---
import { getCollection } from "astro:content";
import ProductGrid from "../produk/ProductGrid.astro";

const products = await getCollection("products");
const bestSellers = products.filter((p) => p.data.badge === "best-seller").map((p) => p.data);
---

<section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
  <h2 class="mb-6 font-display text-3xl font-semibold text-ink md:text-4xl">Best Seller Lintas Kategori</h2>
  <ProductGrid products={bestSellers} />
</section>
