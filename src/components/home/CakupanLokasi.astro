---
// Airtable signature full-bleed card: one bold stat, punctuates the page rhythm.
import { withBase } from "../../lib/base";
---

<section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
  <div class="rounded-lg bg-ink px-6 py-12 text-center text-bg md:px-16 md:py-16">
    <p class="font-display text-5xl font-semibold md:text-7xl">35 Kota</p>
    <p class="mx-auto mt-3 max-w-md text-base text-bg/80">
      Pengiriman flower, cake, dan gift ke 35 kota se-Indonesia, dari Jakarta sampai Jayapura.
    </p>
    <a
      href={withBase("/lokasi/")}
      class="mt-6 inline-block rounded-full bg-cta px-6 py-3 text-sm font-medium text-ink hover:bg-cta-active"
    >
      Lihat Semua Kota
    </a>
  </div>
</section>
