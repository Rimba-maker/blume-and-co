---
const stats = [
  { label: "500+ Kiriman" },
  { label: "4 Kategori Besar" },
  { label: "35 Kota Terjangkau" },
  { label: "Order via WhatsApp" },
];
---
<section class="border-y border-hairline bg-surface-soft px-4 py-6">
  <ul class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-2">
    {stats.map((stat) => (
      <li class="text-sm font-medium text-muted">{stat.label}</li>
    ))}
  </ul>
</section>
