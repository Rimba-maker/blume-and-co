---
import { waLink } from "../../lib/waLink";
---

<section class="bg-cta px-4 py-12 text-center text-ink md:py-16">
  <h2 class="font-display text-2xl font-semibold md:text-3xl">Siap Kirim Kado Hari Ini?</h2>
  <p class="mx-auto mt-3 max-w-md text-ink/80">
    Chat WhatsApp kami, ceritakan momennya, kami bantu pilihkan.
  </p>
  <a
    href={waLink.generic()}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-block rounded-full bg-white px-6 py-3 text-sm font-medium text-ink hover:bg-white/90"
  >
    Order via WhatsApp
  </a>
</section>
