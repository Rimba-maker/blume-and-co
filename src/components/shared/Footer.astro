---
import { flowerSubcategories } from "../../lib/navData";

const popularCities = ["Jakarta", "Bandung", "Surabaya", "Yogyakarta", "Bali", "Medan"];
const citySlug = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<footer class="mt-24 border-t border-hairline bg-surface-soft px-4 py-16">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 md:grid-cols-3 lg:grid-cols-5">
    <div class="col-span-2 md:col-span-3 lg:col-span-1">
      <p class="font-display text-lg font-semibold text-ink">Blume &amp; Co.</p>
      <p class="mt-2 max-w-xs text-sm text-muted">For Every Occasion, Everywhere in Indonesia.</p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Flower</p>
      <ul class="mt-3 flex flex-col gap-2">
        {flowerSubcategories.slice(0, 5).map((s) => (
          <li><a href={`/flower/${s.slug}/`} class="text-sm text-ink hover:underline">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Kategori</p>
      <ul class="mt-3 flex flex-col gap-2">
        <li><a href="/cake-gift/" class="text-sm text-ink hover:underline">Cake &amp; Gift</a></li>
        <li><a href="/bunga-papan/" class="text-sm text-ink hover:underline">Bunga Papan</a></li>
        <li><a href="/occasion/" class="text-sm text-ink hover:underline">Occasion</a></li>
        <li><a href="/new-arrival/" class="text-sm text-ink hover:underline">New Arrival</a></li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Info</p>
      <ul class="mt-3 flex flex-col gap-2">
        <li><a href="/#cara-pesan" class="text-sm text-ink hover:underline">Cara Pesan</a></li>
        <li><a href="/#tentang-kami" class="text-sm text-ink hover:underline">Tentang Kami</a></li>
        <li><a href="/#testimoni" class="text-sm text-ink hover:underline">Testimoni</a></li>
        <li><a href="/kontak/" class="text-sm text-ink hover:underline">Kontak</a></li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Kota Populer</p>
      <ul class="mt-3 flex flex-col gap-2">
        {popularCities.map((city) => (
          <li><a href={`/lokasi/${citySlug(city)}/`} class="text-sm text-ink hover:underline">{city}</a></li>
        ))}
      </ul>
      <a href="/lokasi/" class="mt-2 inline-block text-sm font-semibold text-ink underline">Lihat Semua Kota &rarr;</a>
    </div>
  </div>

  <div class="mx-auto mt-12 flex max-w-6xl flex-col gap-4 border-t border-hairline pt-8 text-sm text-muted md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-1">
      <a href="/katalog-blumeandco.pdf" class="font-medium text-ink hover:underline">Download Katalog PDF</a>
      <p>WhatsApp: 62XXXXXXXXXX &middot; Instagram: @blumeandco.id</p>
      <p>NIB: [Nomor Induk Berusaha]</p>
    </div>
    <p>&copy; {new Date().getFullYear()} Blume &amp; Co.</p>
  </div>
</footer>
