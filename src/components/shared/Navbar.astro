---
import { getCollection } from "astro:content";
import MegaMenu, { type NavItem } from "./MegaMenu.tsx";
import {
  flowerSubcategories,
  bungaPapanSubcategories,
  cakeGiftGroups,
  locationRegions,
} from "../../lib/navData";
import { withBase } from "../../lib/base";

const occasions = await getCollection("occasions");

const items: NavItem[] = [
  { label: "New Arrival", href: withBase("/new-arrival/") },
  {
    label: "Flower",
    href: withBase("/flower/"),
    dropdown: {
      kind: "simple",
      items: flowerSubcategories.map((s) => ({ label: s.label, href: withBase(`/flower/${s.slug}/`) })),
    },
  },
  {
    label: "Cake & Gift",
    href: withBase("/cake-gift/"),
    dropdown: {
      kind: "grouped",
      groups: cakeGiftGroups.map((g) => ({
        title: g.title,
        tint: g.tint,
        items: g.items.map((s) => ({ label: s.label, href: withBase(`/cake-gift/${s.slug}/`) })),
      })),
    },
  },
  {
    label: "Bunga Papan",
    href: withBase("/bunga-papan/"),
    dropdown: {
      kind: "simple",
      items: bungaPapanSubcategories.map((s) => ({ label: s.label, href: withBase(`/bunga-papan/${s.slug}/`) })),
    },
  },
  {
    label: "Occasion",
    href: withBase("/occasion/"),
    dropdown: {
      kind: "simple",
      items: occasions.map((o) => ({ label: o.data.name, href: withBase(`/occasion/${o.data.slug}/`) })),
    },
  },
  {
    label: "Location",
    href: withBase("/lokasi/"),
    dropdown: {
      kind: "grouped",
      groups: locationRegions.map((r) => ({
        title: r.region,
        items: r.cities.map((c) => ({ label: c.label, href: withBase(`/lokasi/${c.slug}/`) })),
      })),
    },
  },
];
---

<header class="sticky top-4 z-40 px-4">
  <MegaMenu items={items} client:load />
</header>
